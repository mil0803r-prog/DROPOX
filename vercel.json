{
  "functions": {
    "api/asistente.js": {
      "maxDuration": 30
    },
    "api/meta.js": {
      "maxDuration": 30
    },
    "api/descargar.js": {
      "maxDuration": 60
    },
    "api/wa.js": {
      "maxDuration": 30
    },
    "api/tienda.js": {
      "maxDuration": 15,
      "includeFiles": "tienda-render.js"
    },
    "api/pedido-tienda.js": {
      "maxDuration": 15,
      "includeFiles": "tienda-render.js"
    },
    "api/importar.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "^/(robots\\.txt|sitemap\\.xml)$",
      "has": [
        {
          "type": "host",
          "value": "^(?!.*\\.vercel\\.app$)(?!localhost)(?!dropox\\.).+$"
        }
      ],
      "dest": "/api/tienda?f=$1"
    },
    {
      "src": "^/(?!api/)([a-z0-9-]*)$",
      "has": [
        {
          "type": "host",
          "value": "^(?!.*\\.vercel\\.app$)(?!localhost)(?!dropox\\.).+$"
        }
      ],
      "dest": "/api/tienda?p=$1"
    },
    {
      "src": "^/(?!api/).*$",
      "has": [
        {
          "type": "host",
          "value": "^(?!.*\\.vercel\\.app$)(?!localhost)(?!dropox\\.).+$"
        }
      ],
      "status": 302,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/t/([^/]+)/([^/]+)$",
      "dest": "/api/tienda?t=$1&p=$2"
    },
    {
      "src": "^/t/([^/]+)$",
      "dest": "/api/tienda?t=$1"
    },
    {
      "handle": "filesystem"
    }
  ]
}